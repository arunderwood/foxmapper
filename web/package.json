{
  "name": "foxmapper-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:validator": "node scripts/generate-validator.mjs",
    "check:validator": "node scripts/generate-validator.mjs --check"
  },
  "dependencies": {
    "@turf/sector": "^7.4.0",
    "d3-contour": "^4.0.3",
    "geomagnetism": "^0.2.0",
    "idb": "^8.0.4",
    "maplibre-gl": "^6.17.0",
    "posthog-js": "^1.447.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "^1.65.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/destination": "^7.3.5",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
