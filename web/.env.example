# PostHog analytics (anonymous, opt-out, no PII). See ../docs/analytics.md.
#
# Both are OPTIONAL. With no key, analytics is a no-op — which is the intended default for local
# development and CI. To exercise it against a real project, copy this file to `.env.local` (git-
# ignored) and fill in the key from your PostHog project's "Web" install snippet.
#
# Vite reads these at build time, so a `dev`/`build` restart is needed after changing them.

# Project API key (starts with `phc_`). Safe to expose in a browser bundle by design.
VITE_PUBLIC_POSTHOG_KEY=

# Ingestion host for your PostHog cloud region. Defaults to US when unset.
#   US cloud: https://us.i.posthog.com
#   EU cloud: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
