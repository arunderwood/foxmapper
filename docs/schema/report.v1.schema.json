{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foxmapper.com/schema/report.v1.json",
  "title": "FoxMapper report, format version 1",
  "description": "What a reader MUST accept before it folds or renders a report. Shape only: the authoring caps (confidence_q in {3,4,5} and the like) and every rule about meaning live in log-format.md. Unknown properties are allowed everywhere and MUST survive a relay (§10). A body that fails this schema is still a member of the log: it counts toward id_digest and is skipped by the fold.",
  "type": "object",
  "required": [
    "v",
    "id",
    "hunt_code",
    "kind",
    "observer",
    "position",
    "position_source",
    "observed_at",
    "clock_offset_ms",
    "entered_by",
    "payload"
  ],
  "properties": {
    "v": {
      "description": "Format version. A v1 reader cannot know what a later version means, so it skips it.",
      "const": 1
    },
    "id": { "$ref": "#/$defs/id" },
    "hunt_code": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["bearing", "omni", "null", "fix", "retraction"]
    },
    "observer": {
      "type": "object",
      "required": ["callsign"],
      "properties": {
        "callsign": { "type": "string" }
      }
    },
    "position": {
      "description": "The observer's position, WGS84 decimal degrees.",
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "position_source": {
      "type": "string",
      "enum": ["measured", "placed"]
    },
    "position_accuracy_m": { "type": "number", "minimum": 0 },
    "observed_at": {
      "description": "UTC epoch milliseconds from the authoring device's clock.",
      "type": "integer"
    },
    "clock_offset_ms": {
      "description": "Device clock minus true time. null means never measured, which is not zero.",
      "type": ["integer", "null"]
    },
    "entered_by": {
      "type": "object",
      "required": ["participant_id", "callsign"],
      "properties": {
        "participant_id": { "type": "string" },
        "callsign": { "type": "string" }
      }
    },
    "payload": { "type": "object" },
    "wire": { "$ref": "#/$defs/wire" }
  },
  "discriminator": { "propertyName": "kind" },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": { "const": "bearing" },
        "payload": { "$ref": "#/$defs/bearingPayload" }
      }
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "omni" },
        "payload": { "$ref": "#/$defs/omniPayload" }
      }
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "null" }
      }
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "fix" }
      }
    },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "retraction" },
        "payload": { "$ref": "#/$defs/retractionPayload" }
      }
    }
  ],
  "$defs": {
    "id": {
      "description": "Writers emit a lowercase canonical UUIDv4 (log-format.md §2) and the relay refuses anything else. Reading needs only a string to compare.",
      "type": "string"
    },
    "digit": {
      "description": "A raw APRS digit, kept undecoded.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "heading": {
      "description": "Degrees clockwise from north, normalized to [0, 360).",
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "bearingPayload": {
      "type": "object",
      "required": [
        "heading_true",
        "heading_magnetic",
        "declination",
        "wmm_epoch",
        "confidence_q",
        "max_range_r"
      ],
      "properties": {
        "heading_true": { "$ref": "#/$defs/heading" },
        "heading_magnetic": { "$ref": "#/$defs/heading" },
        "declination": { "type": "number", "minimum": -180, "maximum": 180 },
        "wmm_epoch": { "type": "string" },
        "confidence_q": { "$ref": "#/$defs/digit" },
        "max_range_r": { "$ref": "#/$defs/digit" }
      }
    },
    "omniPayload": {
      "type": "object",
      "required": ["strength_s"],
      "properties": {
        "strength_s": {
          "description": "0 is not an omni report; nothing heard is kind null.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "retractionPayload": {
      "type": "object",
      "required": ["retracts_id"],
      "properties": {
        "retracts_id": { "$ref": "#/$defs/id" }
      }
    },
    "wire": {
      "description": "Raw on-air fields, on ingested reports only. format is DF, DFS or third-party today; readers do not branch on it to render, so an unrecognised value is not a reason to skip the report.",
      "type": "object",
      "required": ["format", "raw"],
      "properties": {
        "format": { "type": "string" },
        "raw": { "type": "string" },
        "n": { "$ref": "#/$defs/digit" },
        "r": { "$ref": "#/$defs/digit" },
        "q": { "$ref": "#/$defs/digit" },
        "s": { "$ref": "#/$defs/digit" },
        "h": { "$ref": "#/$defs/digit" },
        "g": { "$ref": "#/$defs/digit" },
        "d": { "$ref": "#/$defs/digit" }
      }
    }
  }
}
